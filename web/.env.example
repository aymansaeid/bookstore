# Copy to .env.local (git-ignored) to override. Every value here is optional.

# Where the dev/preview server proxies /api and /uploads.
# Matches the "https" profile in src/BookStore.Api/Properties/launchSettings.json.
API_PROXY_TARGET=https://localhost:7048

# Registers /dev/mock-checkout outside `npm run dev` (e.g. `npm run preview`
# against a Development API). Never set this in production builds.
VITE_ENABLE_MOCK_PAYMENTS=false

# Optional. Leave empty in development (the Vite proxy serves /api on the same origin).
# Production example: https://api.kitapefendi.com
VITE_API_BASE_URL=